{
  "name": "paperdown",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4325",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4325",
    "test": "node --test tests/*.test.ts backend/*.test.mjs cli/*.test.mjs",
    "api": "node backend/server.mjs",
    "build:cli": "tsc -b && vite build --config cli/vite.config.mjs && node cli/notices.mjs",
    "install:cli": "node cli/install.mjs"
  },
  "dependencies": {
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@studio-baeks/paper-ui": "file:vendor/paper-ui",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.18.10",
    "lucide-react": "^1.52.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
