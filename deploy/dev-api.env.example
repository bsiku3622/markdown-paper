# paperdown-dev: separate data, port, and hostnames from production.
PORT=8793
DATA_DIR=/var/lib/paperdown-dev
ALLOWED_ORIGINS=https://paperdown-dev.bsiku.dev
PUBLIC_URL=https://paperdown-dev-api.bsiku.dev
COOKIE_SECURE=true
TRUST_PROXY=true
# Reuses the production Playwright Chromium (read-only); Chromium writes its profile under HOME.
PLAYWRIGHT_BROWSERS_PATH=/var/lib/paperdown/browsers
HOME=/var/lib/paperdown-dev
GOOGLE_CLIENT_ID=
